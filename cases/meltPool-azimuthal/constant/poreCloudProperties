/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      poreCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         false;          // one-way: bubbles read the melt only
    transient       yes;
    cellValueSourceCorrection no;

    maxCo           0.3;

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
        J_MHD           cellPoint;
        gradT           cellPoint;
        "poreCloud:B"   cellPoint;
        curlUcDt        cellPoint;
        DUcDt           cellPoint;
    }

    integrationSchemes
    {
        U               Euler;
    }
}

constantProperties
{
    rho0            1.0;            // gas
}

subModels
{
    particleForces
    {
        gravity;
        sphereDrag;
        virtualMass { Cvm 0.5; }
        pressureGradient { U U; }

        leenovKolin
        {
            J                J_MHD;
            exclusionCoeff   -1.5;
            useSphereAverage true;
        }

        thermocapillary
        {
            gradT            gradT;
            epsilon1         epsilon1;
            epsMin           0.5;
            useSphereAverage true;
        }
    }

    injectionModels
    {
        melt
        {
            type            meltPoolInjection;
            massTotal       0;
            SOI             0.001;
            duration        0.001;
            parcelBasisType fixed;
            nParticle       1;

            rate            1e15;
            alphaName       alpha.metal;
            epsilonName     epsilon1;
            alphaMin        0.5;
            epsMin          0.5;
            maxParcels      20000;

            sizeDistribution
            {
                type            normal;
                normalDistribution
                {
                    mu          35e-6;
                    sigma       10e-6;
                    minValue    10e-6;
                    maxValue    70e-6;
                }
            }
        }
    }

    dispersionModel         none;
    patchInteractionModel   none;
    surfaceFilmModel        none;
    stochasticCollisionModel none;
}

cloudFunctions
{
    solidificationCapture
    {
        type             solidificationCapture;
        epsilonName      epsilon1;
        captureThreshold 0.5;
        allowRemelt      false;
    }

    poreForceReport
    {
        type            poreForceReport;
        writeControl    timeStep;
        writeInterval   1;
        exclusionCoeff  -1.5;
        useSphereAverage true;
        J               J_MHD;
    }
}

// ************************************************************************* //
