/*--------------------------------*- C++ -*----------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      poreCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    coupled         false;          // one-way: bubbles read the melt only
    transient       yes;
    cellValueSourceCorrection no;

    maxCo           0.3;

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
        J_MHD           cellPoint;
        gradT           cellPoint;
        "poreCloud:B"   cellPoint;
        curlUcDt        cellPoint;
        DUcDt           cellPoint;
    }

    integrationSchemes
    {
        U               Euler;
    }
}

constantProperties
{
    rho0            1.0;            // gas
}

subModels
{
    particleForces
    {
        gravity;
        sphereDrag;
        virtualMass { Cvm 0.5; }
        pressureGradient { U U; }

        leenovKolin
        {
            J                J_MHD;
            exclusionCoeff   -1.5;
            useSphereAverage true;
        }

        thermocapillary
        {
            gradT            gradT;
            epsilon1         epsilon1;
            epsMin           0.5;
            useSphereAverage true;
        }
    }

    injectionModels
    {
        melt
        {
            type            meltPoolInjection;
            massTotal       0;
            SOI             0.001;
            duration        0.001;
            parcelBasisType fixed;
            nParticle       1;

            // Nucleation rate per unit LIQUID volume, per second - not per
            // cell and not per run.  The expected count is rate*V_melt*T, so
            // it has to be scaled against the pool this case actually forms:
            // at t = 1 ms the 0.2 T azimuthal pool is 26876 cells of
            // 6.33e-16 m3 = 1.70e-11 m3.  Over the 1 ms injection window that
            // gives ~1700 bubbles here, and more as the pool keeps growing.
            //
            // Was 1e15, which yields ~17 bubbles for the whole millisecond -
            // enough to exercise the code path, far too few for statistics,
            // and three orders short of ever reaching maxParcels.
            rate            1e17;
            alphaName       alpha.metal;
            epsilonName     epsilon1;
            alphaMin        0.5;
            epsMin          0.5;
            maxParcels      20000;

            sizeDistribution
            {
                type            normal;
                normalDistribution
                {
                    mu          35e-6;
                    sigma       10e-6;
                    minValue    10e-6;
                    maxValue    70e-6;
                }
            }
        }
    }

    dispersionModel         none;
    patchInteractionModel   none;
    surfaceFilmModel        none;
    stochasticCollisionModel none;
}

cloudFunctions
{
    solidificationCapture
    {
        type             solidificationCapture;
        epsilonName      epsilon1;
        captureThreshold 0.5;
        allowRemelt      false;
    }

    poreForceReport
    {
        type            poreForceReport;

        // One row per bubble per report, so the row count is
        // nBubbles * nSteps/writeInterval.  This case runs at dt ~ 1.2e-8,
        // i.e. ~83000 steps per millisecond, against a cloud that reaches
        // ~1700 bubbles - so writeInterval 1 is ~1.4e8 rows, tens of GB, and
        // an fwrite on every rank on every step.  25 still resolves a bubble
        // crossing a decomposition plane in several samples.
        //
        // Raise it for a production sweep, or use writeControl writeTime to
        // tie the CSV to the field write cadence instead.
        writeControl    timeStep;
        writeInterval   25;
        exclusionCoeff  -1.5;
        useSphereAverage true;
        J               J_MHD;
    }
}

// ************************************************************************* //
