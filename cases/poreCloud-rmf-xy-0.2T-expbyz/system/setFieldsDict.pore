FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fixed pore positions (reused from reference case)
// Based on liquid-solid interface analysis at t = 1e-04

defaultFieldValues
(
);

regions
(
    // Pore 1
    sphereToCell
    {
        centre  (2.321429e-04 5.026613e-04 2.546875e-04);
        radius  3.5e-05;
        fieldValues
        (
            volScalarFieldValue alpha.metal 0
        );
    }

    // Pore 2
    sphereToCell
    {
        centre  (2.607143e-04 5.026613e-04 2.359375e-04);
        radius  3.5e-05;
        fieldValues
        (
            volScalarFieldValue alpha.metal 0
        );
    }

    // Pore 3
    sphereToCell
    {
        centre  (2.321429e-04 5.026613e-04 2.453125e-04);
        radius  3.5e-05;
        fieldValues
        (
            volScalarFieldValue alpha.metal 0
        );
    }

    // Pore 4
    sphereToCell
    {
        centre  (2.607143e-04 5.026613e-04 2.359375e-04);
        radius  3.5e-05;
        fieldValues
        (
            volScalarFieldValue alpha.metal 0
        );
    }

);

